# Copy to .gateway.env (it holds a key: keep it out of git) and fill in; read by the gateway service.
UPSTREAM_URL=https://openrouter.ai/api/v1
UPSTREAM_KEY=

# Sent upstream instead of the model SillyTavern asks for, so SillyTavern's own model field can stay empty.
MODEL=inclusionai/ling-3.0-flash-sante:free

# Merged over every request: no model reasoning (SillyTavern's own setting cannot send this; effort 'low' still thought 18K tokens).
BODY='{"reasoning":{"enabled":false}}'

# RETRIES=2   # extra attempts on 429/502/503/504 and network errors

# cpa (CLIProxyAPI, on a cloud host) instead of OpenRouter: it needs no key, so leave UPSTREAM_KEY empty (no Authorization
# header is sent). BODY is specific to the upstream: cpa ignores OpenRouter's "reasoning" object (measured: 370 reasoning tokens for a greeting)
# but obeys reasoning_effort (gemini-3.8-flash-high: 9 tokens, 2.3 s).
# The model list has only the -high id of gemini-3.8-flash, so reasoning_effort is the only way to cut thinking. Measured against the
# cloud host, 3 runs each, no chat history (small sample): a short prompt took 3.3-3.6 s with low (no reasoning tokens) and 13-15 s with
# medium (1000-1300 reasoning tokens); a rule-heavy 300-word prompt took 4.8-12.4 s with low (low sometimes thinks ~750 tokens by itself)
# and 15-17 s with medium (~900-1000 tokens). A real roleplay prompt with the preset and world book is larger, so expect slower.
# UPSTREAM_URL=http://gateway.example:8317/v1
# UPSTREAM_KEY=
# MODEL=gemini-3.8-flash-high
# BODY='{"reasoning_effort":"low"}'

# An upstream that is a program on the host, not a container: host.docker.internal is the host. The program has to listen where a
# container can reach it (0.0.0.0, or the docker0 address, which keeps it off the LAN), and not on 8789, which the gateway publishes.
# UPSTREAM_URL=http://host.docker.internal:8790/v1